{
  "name": "karanmelo-page",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -p $PORT",
    "test": "jest \".spec.ts(x)\" -o --watchAll=false",
    "test:watch": "jest \".spec.ts(x)\" -o --watch",
    "test:e2e": "jest \".spec.ts(x)\" -o --runInBand --testTimeout=10000",
    "test:cov": "jest -u --ci --silent --coverage --runInBand --watchAll --testResultsProcessor jest-sonar-reporter",
    "test:ci": "CI=true jest \".spec.tsx\" -u --silent --verbose --passWithNoTests",
    "sonar": "node sonar-project.js",
    "eject": "react-scripts eject",
    "lint": "tsc --noEmit && eslint --fix .",
    "fix": "yarn lint --fix"
  },
  "dependencies": {
    "@serwist/next": "^9.5.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.2.8",
    "serwist": "^9.5.12",
    "sharp": "^0.35.4",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/node": "^7.29.6",
    "@eslint/create-config": "^0.2.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-styled-components": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "jest": "^30.5.1",
    "jest-sonar-reporter": "^2.0.0",
    "prettier": "^3.9.6",
    "properties-reader": "^2.2.0",
    "react-test-renderer": "^19.2.8",
    "sonarqube-scanner": "^2.8.1",
    "ts-jest": "^29.4.12",
    "typescript-eslint": "^8.69.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": -10
      }
    }
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  }
}
